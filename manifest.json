{
  "manifest_version": 3,
  "name": "SiteLens",
  "short_name": "SiteLens",
  "version": "0.1.0",
  "description": "Crawl and diagnose web apps for AI review with per-page screenshots, console, network, performance, accessibility and DOM context.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "debugger",
    "downloads",
    "scripting",
    "sidePanel",
    "storage",
    "tabs"
  ],
  "action": {
    "default_title": "Open SiteLens"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
